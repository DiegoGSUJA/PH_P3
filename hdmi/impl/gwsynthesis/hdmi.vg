`pragma protect end_protected
module DVI_TX_Top (
  pixel_clk,
  ser_clk,
  rst_n_d,
  de_Z,
  v_sync_Z,
  h_sync_Z,
  r,
  g,
  tmds_clk_p,
  tmds_clk_n,
  n36_6_3,
  tmds_data_p,
  tmds_data_n
)
;
input pixel_clk;
input ser_clk;
input rst_n_d;
input de_Z;
input v_sync_Z;
input h_sync_Z;
input [7:7] r;
input [5:5] g;
output tmds_clk_p;
output tmds_clk_n;
output n36_6_3;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
wire VCC;
wire GND;
  \~rgb2dvi.DVI_TX_Top  rgb2dvi_inst (
    .pixel_clk(pixel_clk),
    .ser_clk(ser_clk),
    .rst_n_d(rst_n_d),
    .de_Z(de_Z),
    .v_sync_Z(v_sync_Z),
    .h_sync_Z(h_sync_Z),
    .r(r[7]),
    .g(g[5]),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .n36_6_3(n36_6_3),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
endmodule /* DVI_TX_Top */
module top (
  clk,
  rst_n,
  tmds_data_p,
  tmds_data_n,
  tmds_clk_p,
  tmds_clk_n
)
;
input clk;
input rst_n;
output [2:0] tmds_data_p;
output [2:0] tmds_data_n;
output tmds_clk_p;
output tmds_clk_n;
wire clk_d;
wire rst_n_d;
wire r_7_7;
wire r_7_8;
wire r_7_9;
wire r_7_10;
wire r_7_11;
wire r_7_12;
wire r_7_13;
wire r_7_14;
wire ser_clk;
wire pixel_clk;
wire h_sync_Z;
wire v_sync_Z;
wire de_Z;
wire n44_8;
wire n41_8;
wire n45_10;
wire n36_6_3;
wire [5:5] g;
wire [7:7] r;
wire [11:0] h_cnt;
wire [11:2] v_cnt;
wire VCC;
wire GND;
  IBUF clk_ibuf (
    .O(clk_d),
    .I(clk) 
);
  IBUF rst_n_ibuf (
    .O(rst_n_d),
    .I(rst_n) 
);
  LUT2 g_5_s1 (
    .F(g[5]),
    .I0(r[7]),
    .I1(de_Z) 
);
defparam g_5_s1.INIT=4'h4;
  LUT4 r_7_s1 (
    .F(r[7]),
    .I0(r_7_7),
    .I1(r_7_8),
    .I2(r_7_9),
    .I3(r_7_10) 
);
defparam r_7_s1.INIT=16'h4000;
  LUT4 r_7_s2 (
    .F(r_7_7),
    .I0(n44_8),
    .I1(v_cnt[2]),
    .I2(n45_10),
    .I3(n41_8) 
);
defparam r_7_s2.INIT=16'hE000;
  LUT4 r_7_s3 (
    .F(r_7_8),
    .I0(h_cnt[10]),
    .I1(h_cnt[11]),
    .I2(r_7_11),
    .I3(r_7_12) 
);
defparam r_7_s3.INIT=16'h1000;
  LUT4 r_7_s4 (
    .F(r_7_9),
    .I0(h_cnt[8]),
    .I1(h_cnt[6]),
    .I2(h_cnt[7]),
    .I3(r_7_13) 
);
defparam r_7_s4.INIT=16'h4000;
  LUT4 r_7_s5 (
    .F(r_7_10),
    .I0(r_7_14),
    .I1(h_cnt[3]),
    .I2(h_cnt[4]),
    .I3(h_cnt[5]) 
);
defparam r_7_s5.INIT=16'hBFFC;
  LUT2 r_7_s6 (
    .F(r_7_11),
    .I0(v_cnt[8]),
    .I1(v_cnt[9]) 
);
defparam r_7_s6.INIT=4'h1;
  LUT4 r_7_s7 (
    .F(r_7_12),
    .I0(v_cnt[10]),
    .I1(v_cnt[11]),
    .I2(v_cnt[6]),
    .I3(v_cnt[7]) 
);
defparam r_7_s7.INIT=16'h1000;
  LUT4 r_7_s8 (
    .F(r_7_13),
    .I0(v_cnt[3]),
    .I1(v_cnt[4]),
    .I2(v_cnt[5]),
    .I3(h_cnt[9]) 
);
defparam r_7_s8.INIT=16'h00FE;
  LUT3 r_7_s9 (
    .F(r_7_14),
    .I0(h_cnt[1]),
    .I1(h_cnt[0]),
    .I2(h_cnt[2]) 
);
defparam r_7_s9.INIT=8'h07;
  ser_gen u_pull (
    .clk_d(clk_d),
    .ser_clk(ser_clk)
);
  pixel_gen d_pull (
    .ser_clk(ser_clk),
    .rst_n_d(rst_n_d),
    .pixel_clk(pixel_clk)
);
  sync_gen sync_gen_inst (
    .pixel_clk(pixel_clk),
    .n36_6_3(n36_6_3),
    .h_sync_Z(h_sync_Z),
    .v_sync_Z(v_sync_Z),
    .de_Z(de_Z),
    .n44_8(n44_8),
    .n41_8(n41_8),
    .n45_10(n45_10),
    .h_cnt(h_cnt[11:0]),
    .v_cnt(v_cnt[11:2])
);
  DVI_TX_Top hdmi (
    .pixel_clk(pixel_clk),
    .ser_clk(ser_clk),
    .rst_n_d(rst_n_d),
    .de_Z(de_Z),
    .v_sync_Z(v_sync_Z),
    .h_sync_Z(h_sync_Z),
    .r(r[7]),
    .g(g[5]),
    .tmds_clk_p(tmds_clk_p),
    .tmds_clk_n(tmds_clk_n),
    .n36_6_3(n36_6_3),
    .tmds_data_p(tmds_data_p[2:0]),
    .tmds_data_n(tmds_data_n[2:0])
);
  VCC VCC_cZ (
    .V(VCC)
);
  GND GND_cZ (
    .G(GND)
);
  GSR GSR (
    .GSRI(VCC) 
);
endmodule /* top */
